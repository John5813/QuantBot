# Nusxa oling:  cp .env.example .env   — keyin qiymatlarni to'ldiring.
# .env fayli .gitignore'da — GitHub'ga chiqmaydi.

# True = virtual savdo (pulsiz). Real savdo moduli hali yozilmagan, False qilinsa bot ishga tushmaydi.
PAPER_TRADING=true

# Telegram: @BotFather'dan token, @userinfobot'dan o'zingizning chat ID'ingiz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Veb-panel. Standart: faqat 127.0.0.1 (SSH tunnel orqali kiriladi).
# Internetdan ochmoqchi bo'lsangiz: WEB_HOST=0.0.0.0 va uzun tasodifiy token qo'ying
# (masalan: python3 -c "import secrets; print(secrets.token_urlsafe(24))")
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_DASHBOARD_TOKEN=

# So'm kursi va vaqt zonasi (O'zbekiston = UTC+5)
UZS_PER_USD=12800
TZ_OFFSET_HOURS=5

# Real savdo uchun (hozircha ishlatilmaydi)
BINANCE_API_KEY=
BINANCE_API_SECRET=
